{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "ledger.football" }],
      "destination": "https://sunday.ledger.football/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.ledger.football" }],
      "destination": "https://sunday.ledger.football/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "afcvsnfc.com" }],
      "destination": "https://sunday.ledger.football/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.afcvsnfc.com" }],
      "destination": "https://sunday.ledger.football/:path",
      "permanent": true
    }
  ]
}
